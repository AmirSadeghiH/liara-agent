# ============================================================
# LiaraPilot - Local Development Configuration
# این فایل فقط برای محیط توسعه محلی است.
# مقدار واقعی توکن‌ها را خودت جایگزین کن.
# این فایل قابل انتشار است و هیچ راز واقعی در آن نیست.
# ============================================================

# -------------------------
# برنامه و رابط کاربری
# -------------------------

APP_NAME=LiaraPilot
APP_ENV=development

# برای توسعه روی همین کامپیوتر بماند؛
# برای دسترسی شبکه‌ای باید احراز هویت اجباری شود.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# کلید نشست برنامه؛ برای محیط غیرمحلی باید مقدار تصادفی امن داشته باشد.
# این مقدار را با LIARA_API_TOKEN اشتباه نگیر.
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# احراز هویت داخلی برنامه.
# غیرفعال بودن فقط برای توسعه loopback مجاز است.
APP_AUTH_ENABLED=false
APP_ACCESS_TOKEN=

# ریشه اطلاعات برنامه
DATA_DIR=./data

# -------------------------
# Demo Mode
# -------------------------

# true: تمام اطلاعات لیارا و عملیات متصل به آن شبیه‌سازی می‌شود.
# false: امکان استفاده از API واقعی وجود دارد.
# در حالت Demo نباید درخواست واقعی تغییردهنده به لیارا ارسال شود.
DEMO_MODE=true

# سناریوی نمونه برای نمایش خطای برنامه: django_500 | healthy_site | memory_pressure
DEMO_SCENARIO=django_500

# مکث کوتاه بین گره‌های گردش‌کار در حالت دمو، تا مراحل در UI دیده شوند.
# در تست‌ها این مقدار صفر می‌شود.
DEMO_STEP_DELAY_SECONDS=0.35

# -------------------------
# پایگاه داده و وضعیت Agent
# -------------------------

# برای نسخه MVP از SQLite استفاده کن.
DATABASE_URL=sqlite+aiosqlite:///./data/liarapilot.db

# مسیر ذخیره Checkpointهای LangGraph.
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph-checkpoints.sqlite

# -------------------------
# LLM
# -------------------------

# مقادیر مجاز:
# openai_compatible
# disabled
LLM_PROVIDER=disabled

# اتصال OpenAI-compatible؛ در صورت استفاده از ارائه‌دهنده دیگر
# URL و مدل دقیق همان ارائه‌دهنده را وارد کن.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# بدون LLM، دمو باید با تحلیل مبتنی بر قواعد قابل اجرا باشد.
# تحلیل ساده قاعده‌محور را تحلیل پیشرفته مدل جا نزن.

# -------------------------
# Liara API
# -------------------------

LIARA_BASE_URL=https://api.liara.ir
LIARA_API_TOKEN=

# طبق نمونه درخواست‌های مستندات جاری لیارا، توکن به‌صورت
# «Authorization: <api-key>» ارسال می‌شود (بدون پیشوند Bearer).
# گزینه‌های مجاز: token | Bearer
# اگر حساب تو با Bearer کار می‌کند، این مقدار را Bearer بگذار.
LIARA_AUTH_SCHEME=token

LIARA_REQUEST_TIMEOUT_SECONDS=30
LIARA_MAX_RETRIES=2

# فهرست پروژه‌هایی که این برنامه اجازه عملیات تغییردهنده روی آن‌ها دارد.
# نام‌ها را با کاما جدا کن.
# خالی بودن آن باید اجرای عملیات تغییردهنده را متوقف کند.
LIARA_DEPLOY_ALLOWED_PROJECTS=

# مجوز کلی برای عملیات تغییردهنده.
# پیش‌فرض false بماند.
LIARA_ALLOW_WRITES=false

# اجازه دیپلوی واقعی؛ حتی با true بودن آن تأییدهای لازم اجباری‌اند.
LIARA_ENABLE_DEPLOY=false

# حداکثر حجم بسته سورس بر حسب مگابایت.
LIARA_SOURCE_UPLOAD_MAX_MB=50

# پورت پیش‌فرض فقط زمانی استفاده می‌شود که هیچ Release قبلی پورتی برنگرداند.
# مقدار واقعی باید با پورت برنامه هم‌خوان باشد.
LIARA_DEFAULT_PORT=3000

# -------------------------
# Coding Agent
# -------------------------

# none | claude_code | codex
CODING_AGENT_PROVIDER=none

# ریشه مجاز ساخت Workspaceهای موقت.
CODING_AGENT_WORKSPACE_ROOT=./data/workspaces

# مسیر یک کلون محلی از مخزن برنامه برای اجرای تعمیر واقعی.
# خالی بودن یعنی «تحویل دستی»؛ هیچ مخزنی حدس زده نمی‌شود.
CODING_AGENT_REPO_PATH=

# timeout فرایند ایجنت کدنویسی
CODING_AGENT_TIMEOUT_SECONDS=900

# حداکثر تعداد تلاش برای اصلاح یک مشکل
CODING_AGENT_MAX_REPAIR_ATTEMPTS=3

# محدودیت نوبت‌ها/تلاش‌های داخلی ایجنت، در صورت پشتیبانی CLI
CODING_AGENT_MAX_TURNS=8

# اجازه استفاده از ایجنت واقعی باید آگاهانه فعال شود.
CODING_AGENT_AUTO_EXECUTE=false

# Push واقعی به Git از ابتدا غیرفعال است.
CODING_AGENT_ALLOW_GIT_PUSH=false

# -------------------------
# Human-in-the-Loop
# -------------------------

HITL_APPROVAL_TTL_MINUTES=15

# برای دیپلوی Production تأیید لازم است.
HITL_REQUIRE_PRODUCTION_DEPLOY_APPROVAL=true

# Push واقعی به مخزن نیازمند تأیید است.
HITL_REQUIRE_GIT_PUSH_APPROVAL=true

# تغییرات ریسک‌بالا همیشه نیازمند بررسی مجوز هستند.
HITL_REQUIRE_HIGH_RISK_APPROVAL=true

# -------------------------
# Verification
# -------------------------

# اگر URL سلامت تعریف نشده باشد، آدرس سلامت را حدس نزن.
# کاربر می‌تواند URL واقعی سایت را وارد کند.
DEPLOY_HEALTHCHECK_URL=

DEPLOY_HEALTHCHECK_EXPECT_STATUS=200
DEPLOY_HEALTHCHECK_RETRIES=6
DEPLOY_HEALTHCHECK_INTERVAL_SECONDS=10
DEPLOY_HEALTHCHECK_TIMEOUT_SECONDS=10

# -------------------------
# ثبت رویدادها
# -------------------------

AUDIT_LOG_PATH=./data/audit.jsonl
LOG_REDACT_SECRETS=true
